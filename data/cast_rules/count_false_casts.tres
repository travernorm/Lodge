[ext_resource type="Script" path="res://scripts/casting/rules/tiered_rules.gd" id="1_rules"]

[resource]
script = ExtResource("1_rules")
display_name = "Count the false casts"
description = "No false casts = Short, one = Middle, two or more = Long. Each step up slows the beat a little. A sloppy false cast doesn't climb."
