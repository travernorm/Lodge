[resource]
script = ExtResource("1_fly")
id = &"parachute_adams"
display_name = "Parachute Adams"
description = "Grey all-rounder that passes for most mayflies. Dad's box has more of these than anything else."
body_color = Color(0.54, 0.54, 0.54, 1)
wing_color = Color(1, 1, 1, 1)
hackle_color = Color(0.54, 0.42, 0.29, 1)
imitates = Array[ExtResource("2_insect")]([ExtResource("4_pmd"), ExtResource("3_baetis"), ExtResource("5_march_brown"), ExtResource("6_mahogany"), ExtResource("7_callibaetis")])
