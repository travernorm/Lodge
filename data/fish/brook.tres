[gd_resource type="Resource" script_class="FishSpecies" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/fishing/fish_species.gd" id="1_species"]
[ext_resource type="Script" path="res://scripts/fishing/diet_entry.gd" id="2_diet"]
[ext_resource type="Resource" path="res://data/insects/attractor.tres" id="3_attractor"]
[ext_resource type="Resource" path="res://data/insects/caddis.tres" id="4_caddis"]
[ext_resource type="Resource" path="res://data/insects/pmd.tres" id="5_pmd"]

[sub_resource type="Resource" id="diet_attractor"]
script = ExtResource("2_diet")
insect = ExtResource("3_attractor")
weight = 1.0

[sub_resource type="Resource" id="diet_caddis"]
script = ExtResource("2_diet")
insect = ExtResource("4_caddis")
weight = 1.0

[sub_resource type="Resource" id="diet_pmd"]
script = ExtResource("2_diet")
insect = ExtResource("5_pmd")
weight = 1.0

[resource]
script = ExtResource("1_species")
id = &"brook"
display_name = "Brook Trout"
description = "Worm-track back, white-edged fins. Tucks along the slow far edge of the pool and strikes fast."
color = Color(0.3, 0.32, 0.24, 1)
bite_chance = 0.6
diet = Array[ExtResource("2_diet")]([SubResource("diet_attractor"), SubResource("diet_caddis"), SubResource("diet_pmd")])
selectivity = 0.2
water_min_f = 30
water_max_f = 60
set_min = 0.08
set_max = 0.45
pull = 0.55
toughness = 0.8
min_length_in = 6.0
max_length_in = 12.0
