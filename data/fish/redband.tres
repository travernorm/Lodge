[resource]
script = ExtResource("1_species")
id = &"redband"
display_name = "Redband Rainbow"
description = "The desert-side rainbow of Eastern Oregon. Holds in the slack water behind the boulder at the head of the pool, darting out to sip mayflies drifting down the seams."
color = Color(0.3, 0.34, 0.3, 1)
bite_chance = 0.6
