[gd_resource type="Resource" script_class="FishSpecies" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/fishing/fish_species.gd" id="1_species"]

[resource]
script = ExtResource("1_species")
id = &"redband"
display_name = "Redband Rainbow"
description = "The desert-side rainbow of Eastern Oregon. Holds in the slack water behind the boulder at the head of the pool, darting out to sip mayflies drifting down the seams."
color = Color(0.3, 0.34, 0.3, 1)
lie_area_m = Rect2(18.75, 9.25, 6.25, 3)
preferred_flies = PackedStringArray("parachute_adams")
bite_chance = 0.6
bite_range_m = 5.0
set_min = 0.1
set_max = 1.0
pull = 0.65
toughness = 1.2
min_length_in = 10.0
max_length_in = 20.0
