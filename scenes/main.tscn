[node name="Cast" type="Node2D" parent="."]
script = ExtResource("3_cast")

[node name="Fishing" type="Node2D" parent="."]
script = ExtResource("4_fishing")

[node name="Practice" type="Node2D" parent="."]
script = ExtResource("9_practice")

[node name="Weather" type="CanvasLayer" parent="."]
layer = 5

[node name="WeatherView" type="Node2D" parent="Weather"]
script = ExtResource("13_weather")
look = ExtResource("14_weather_look")

[node name="DebugLayer" type="CanvasLayer" parent="."]
layer = 10

[node name="DebugOverlay" type="Control" parent="DebugLayer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_debug")

[connection signal="conditions_changed" from="Fishing" to="Weather/WeatherView" method="show_conditions"]
[connection signal="day_requested" from="Weather/WeatherView" to="Fishing" method="set_conditions"]
[connection signal="rain_on_water" from="Weather/WeatherView" to="Water" method="set_rain"]
[connection signal="ground_wet" from="Weather/WeatherView" to="Bank" method="set_wetness"]
[connection signal="wind_blew" from="Grass" to="Weather/WeatherView" method="set_wind"]
[connection signal="view_changed" from="DebugLayer/DebugOverlay" to="Weather/WeatherView" method="set_debug_view"]
[connection signal="conditions_changed" from="Fishing" to="Grass" method="show_conditions"]
[connection signal="view_changed" from="DebugLayer/DebugOverlay" to="Grass" method="set_debug_view"]
